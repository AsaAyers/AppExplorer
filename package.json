{
  "name": "app-explorer",
  "displayName": "app-explorer",
  "description": "Helps build documentation while navigating through code",
  "version": "0.3.0",
  "publisher": "asa-ayers",
  "repository": "https://github.com/AsaAyers/AppExplorer",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "type": "module",
  "main": "app-explorer.cjs",
  "scripts": {
    "build:extension": "node esbuild.cjs",
    "build:next": "next build",
    "build:tests": "node build-tests.cjs",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "dev": "DEBUG='*app-explorer:*' PORT=3000 node server.ts",
    "docker": "docker build -t app-explorer:latest . && docker run --rm -p 3000:9045 app-explorer:latest",
    "font-icon": "npx svgtofont --sources public/logo/ --output ./font --fontName app-explorer",
    "format": "prettier --write .",
    "format:check": "prettier --check 'src/**/*.{ts,js,json,css,html}'",
    "lint": "eslint src --fix --max-warnings 0",
    "postbuild": "./patch-standalone.sh",
    "prepare": "[ -d '.husky' ] && husky install || true",
    "pretest": "npm-run-all -p build:tests vscode:prepublish",
    "start": "NODE_ENV=production node server.ts",
    "test": "vscode-test --coverage",
    "type-check": "tsc --noEmit",
    "validate": "npm-run-all format lint type-check",
    "vscode:prepublish": "npm-run-all -s validate build:extension",
    "watch:esbuild": "node esbuild.cjs --watch",
    "watch:lint": "eslint src --watch",
    "watch:tsc": "tsc --noEmit --watch"
  },
  "contributes": {
    "commands": [
      {
        "command": "app-explorer.navigate",
        "title": "AppExplorer: Navigate to Card"
      },
      {
        "command": "app-explorer.updateExtension",
        "title": "AppExplorer: Update Extension"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "app-explorer.navigate",
          "when": "appExplorer.enabled"
        },
        {
          "command": "app-explorer.updateExtension",
          "when": "config.appExplorer.updateExtension"
        }
      ]
    },
    "colors": [
      {
        "id": "appExplorer.background",
        "description": "Background applied to code that is connected to a card.",
        "defaults": {
          "dark": "#183c4a",
          "light": "#eaf8fd",
          "highContrast": "#183c4a66"
        }
      },
      {
        "id": "appExplorer.selectedBackground",
        "description": "Background applied to code that is connected to a card.",
        "defaults": {
          "dark": "#223a1a",
          "light": "#f4faef",
          "highContrast": "#f2ff0066"
        }
      },
      {
        "id": "appExplorer.selectedBorder",
        "description": "Border applied to code that is connected to a card.",
        "defaults": {
          "dark": "#f4ff00",
          "light": "#4ec2ea",
          "highContrast": "#f4ff0066"
        }
      },
      {
        "id": "appExplorer.rulerColor",
        "description": "Color of the ruler line that represents cards.",
        "defaults": {
          "dark": "#0000ff",
          "light": "#0000ff",
          "highContrast": "#0000ff"
        }
      }
    ],
    "configuration": {
      "title": "AppExplorer",
      "properties": {
        "appExplorer.debug": {
          "type": "string",
          "default": null,
          "description": "Set debug namespace"
        },
        "appExplorer.internal.serverPort": {
          "type": "integer",
          "default": 9042,
          "minimum": 1024,
          "maximum": 65535,
          "description": "⚠️ INTERNAL USE ONLY: Server port for E2E testing. Production Miro integration MUST use port 9042. Only modify for automated testing purposes.",
          "scope": "application"
        }
      }
    },
    "icons": {
      "app-explorer": {
        "description": "AppExplorer Icon",
        "default": {
          "fontPath": "font/app-explorer.woff",
          "fontCharacter": "\\ea02"
        }
      }
    },
    "iconFonts": [
      {
        "id": "app-explorer-font",
        "src": [
          {
            "path": "font/app-explorer.woff",
            "format": "woff"
          }
        ]
      }
    ]
  },
  "resolutions": {
    "@types/express": "4.17.25",
    "@types/express-serve-static-core": "4.19.8"
  },
  "devDependencies": {
    "@mirohq/miro-api": "^2.2.4",
    "@next/env": "^16.2.2",
    "@types/compression": "^1.7.3",
    "@types/debug": "^4.1.12",
    "@types/express": "^4.17.17",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.5",
    "@types/node": "20.x",
    "@types/react": "19.2.14",
    "@types/socket.io-client": "^3.0.0",
    "@types/vscode": "^1.98.0",
    "@types/ws": "^8.5.5",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "cookie": "^1.1.1",
    "date-fns": "^4.1.0",
    "debug": "^4.4.1",
    "esbuild": "^0.25.0",
    "esbuild-raw-plugin": "^0.3.1",
    "eslint": "^9.21.0",
    "framer-motion": "^12.38.0",
    "husky": "^9.1.7",
    "jose": "^6.2.2",
    "mocha": "^10.2.0",
    "motion": "^12.38.0",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.59.1",
    "prom-client": "^15.1.3",
    "raw-loader": "^4.0.2",
    "rimraf": "^6.1.3",
    "swc-plugin-coverage-instrument": "^0.0.32",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^5.4.11",
    "vitest": "^4.1.4",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "@lit/context": "^1.1.6",
    "@lit/task": "^1.0.3",
    "@mirohq/websdk-types": "^2.9.5",
    "@sentry/nextjs": "^10.47.0",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "classnames": "^2.5.1",
    "compression": "^1.7.4",
    "express": "^4.18.2",
    "lit": "^3.3.1",
    "lit-html": "^3.0.0",
    "mermaid": "^11.9.0",
    "mirotone": "^5.3.2",
    "morgan": "^1.10.0",
    "next": "^16.2.3",
    "prettier": "^3.4.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "remove-markdown": "^0.6.3",
    "sinon": "^21.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tiny-invariant": "^1.3.1",
    "ws": "^8.14.1"
  }
}
