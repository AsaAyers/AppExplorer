{
  "publisher": "AsaAyers",
  "name": "app-explorer",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.115.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onUri",
    "onStartupFinished"
  ],
  "main": "app-explorer.cjs",
  "scripts": {
    "dev": "DEBUG='*app-explorer:*' PORT=3000 node server.js",
    "build": "npm-run-all --parallel build:next build:extension",
    "build:next": "next build",
    "build:extension": "node esbuild.cjs",
    "postbuild": "./patch-standalone.sh",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "format": "prettier --write .",
    "pretypecheck": "npx next typegen",
    "watch:tsc": "tsc --watch",
    "typecheck": "tsc",
    "docker": "docker build -t app-explorer:latest . && docker run --rm -p 3000:3000 app-explorer:latest",
    "lint": "eslint src --fix --max-warnings 0",
    "font-icon": "npx svgtofont --sources public/logo/ --output ./font --fontName app-explorer",
    "logo-128": "node scripts/make-logo-128x128.mjs",
    "validate": "npm-run-all format lint typecheck test",
    "vscode:prepublish": "npm-run-all --serial validate 'build:extension --production'",
    "prepare": "[ -d '.husky' ] && husky install || true",
    "pretest": "npm run build",
    "test": "vscode-test --coverage --inline-diffs --full-trace -j 1"
  },
  "contributes": {
    "commands": [
      {
        "command": "app-explorer.navigate",
        "title": "AppExplorer: Navigate to Card"
      },
      {
        "command": "app-explorer.updateExtension",
        "title": "AppExplorer: Update Extension"
      },
      {
        "command": "app-explorer.disconnectSession",
        "title": "AppExplorer: Disconnect Session"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "app-explorer.navigate",
          "when": "appExplorer.enabled"
        },
        {
          "command": "app-explorer.updateExtension",
          "when": "config.appExplorer.updateExtension"
        },
        {
          "command": "app-explorer.disconnectSession",
          "when": "appExplorer.enabled"
        }
      ]
    },
    "colors": [
      {
        "id": "appExplorer.background",
        "description": "Background applied to code that is connected to a card.",
        "defaults": {
          "dark": "#183c4a",
          "light": "#eaf8fd",
          "highContrast": "#183c4a66"
        }
      },
      {
        "id": "appExplorer.selectedBackground",
        "description": "Background applied to code that is connected to a card.",
        "defaults": {
          "dark": "#223a1a",
          "light": "#f4faef",
          "highContrast": "#f2ff0066"
        }
      },
      {
        "id": "appExplorer.selectedBorder",
        "description": "Border applied to code that is connected to a card.",
        "defaults": {
          "dark": "#f4ff00",
          "light": "#4ec2ea",
          "highContrast": "#f4ff0066"
        }
      },
      {
        "id": "appExplorer.rulerColor",
        "description": "Color of the ruler line that represents cards.",
        "defaults": {
          "dark": "#0000ff",
          "light": "#0000ff",
          "highContrast": "#0000ff"
        }
      }
    ],
    "configuration": {
      "title": "AppExplorer",
      "properties": {
        "appExplorer.debug": {
          "type": "string",
          "default": null,
          "description": "Set debug namespace"
        }
      }
    },
    "icons": {
      "app-explorer": {
        "description": "AppExplorer Icon",
        "default": {
          "fontPath": "font/app-explorer.woff",
          "fontCharacter": "\\ea02"
        }
      }
    },
    "iconFonts": [
      {
        "id": "app-explorer-font",
        "src": [
          {
            "path": "font/app-explorer.woff",
            "format": "woff"
          }
        ]
      }
    ]
  },
  "svgtofont": {
    "css": false,
    "emptyDist": true,
    "outSVGPath": false,
    "generateInfoData": false,
    "outSVGReactNative": false,
    "outSVGReact": false,
    "outSVGVue": false
  },
  "resolutions": {
    "@types/express": "4.17.25",
    "@types/express-serve-static-core": "4.19.8"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mirohq/miro-api": "^2.2.4",
    "@mirohq/websdk-types": "^2.17.2",
    "@next/mdx": "^16.1.6",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@sentry/nextjs": "^10",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "@types/mdx": "^2.0.13",
    "classnames": "^2.5.1",
    "compression": "^1.8.1",
    "cookie": "^1.1.1",
    "date-fns": "^4.1.0",
    "debug": "^4.4.3",
    "dotenv": "^17.2.3",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "express": "^5.2.1",
    "jose": "^6.1.3",
    "micro": "^10.0.1",
    "mirotone": "^5.3.2",
    "morgan": "^1.10.1",
    "motion": "^12.29.0",
    "next": "16.1.2",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "prettier": "^3.8.0",
    "prisma": "^7.3.0",
    "prom-client": "^15.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "redis": "^5.10.0",
    "remark-gfm": "^4.0.1",
    "remove-markdown": "^0.6.3",
    "selfsigned": "^5.5.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^20.2.0",
    "suspend-react": "^0.1.3",
    "tiny-invariant": "^1.3.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@lit/context": "^1.1.6",
    "@lit/task": "^1.0.3",
    "@octokit/webhooks-types": "^7.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/compression": "^1.8.1",
    "@types/debug": "^4.1.12",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/vscode": "^1.115.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "^0.27.2",
    "esbuild-raw-plugin": "^0.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.2",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^8.0.0",
    "lit": "^3.3.2",
    "lit-html": "^3.3.2",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.59.1",
    "raw-loader": "^4.0.2",
    "rimraf": "^6.1.3",
    "start-server-and-test": "^2.1.3",
    "swc-plugin-coverage-instrument": "^0.0.32",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
